    Blur,
    TweenInfo4,
    {
        Size = 56
    }
)

StrengthTween:Play()
BlurTween:Play()

StrengthTween.Completed:Wait()

HALLU:Destroy() 

ShakeRunning = false

if ImageLabel and ImageLabel.Parent then
    ImageLabel.Position = OriginalPosition
end

Strength:Destroy()




                    local PlayerGui = LPlayer:FindFirstChildOfClass("PlayerGui")

                    if not PlayerGui then
                        return
                    end

                    local BlinkGui = Instance.new("ScreenGui")
                    BlinkGui.Name = "PaintingBlaBlink"
                    BlinkGui.IgnoreGuiInset = true
                    BlinkGui.ResetOnSpawn = false
                    BlinkGui.DisplayOrder = 999999
                    BlinkGui.Parent = PlayerGui

