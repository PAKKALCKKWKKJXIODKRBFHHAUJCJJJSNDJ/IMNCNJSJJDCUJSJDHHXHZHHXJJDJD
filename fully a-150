local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local LPlayer = Players.LocalPlayer
local Char = LPlayer.Character or LPlayer.CharacterAdded:Wait()

local FileName = "PaintingBla.rbxm"
local Url = "https://github.com/lynguyen26031993-design/-u/raw/refs/heads/main/Place_6839171747_Model_PaintingBla_1790439898.txt"

if not isfile(FileName) then
    writefile(FileName, game:HttpGet(Url))
end

local Asset = getcustomasset(FileName)
local Model = game:GetObjects(Asset)[1]

if not Model then
    return
end

local LatestRoom = ReplicatedStorage.GameData.LatestRoom.Value
local Room = workspace.CurrentRooms:FindFirstChild(tostring(LatestRoom))

if not Room then
    return
end

local Assets = Room:FindFirstChild("Assets")
local LightFixtures = Assets and Assets:FindFirstChild("Light_Fixtures")

if not LightFixtures then
    return
end

local Fixtures = {}

for _, Obj in ipairs(LightFixtures:GetChildren()) do
    if Obj:IsA("Model") then
        table.insert(Fixtures, Obj)
    end
end

if #Fixtures == 0 then
    return
end

local Fixture = Fixtures[math.random(1, #Fixtures)]
local Stand = Fixture:FindFirstChild("Stand", true)

if not Stand or not Stand:IsA("BasePart") then
    return
end

for _, Obj in ipairs(Fixture:GetDescendants()) do
    if Obj:IsA("Light")
        or Obj:IsA("ParticleEmitter")
        or Obj:IsA("Beam")
        or Obj:IsA("Trail") then

        Obj.Enabled = false

    elseif Obj:IsA("BasePart") then
        Obj.Transparency = 1
    end
end

Model.Parent = workspace

local Canvas = Model:FindFirstChild("Canvas", true)

if not Canvas or not Canvas:IsA("BasePart") then
    Model:Destroy()
    return
end

local SurfaceGui = Canvas:FindFirstChild("SurfaceGui")
local ImageLabel

if SurfaceGui then
    ImageLabel = SurfaceGui:FindFirstChild("ImageLabel")

    if ImageLabel and ImageLabel:IsA("ImageLabel") then
        ImageLabel.Image = "rbxassetid://12471460355"
        ImageLabel.ImageTransparency = 0
    end
end

local TargetCFrame =
    Stand.CFrame + Stand.CFrame.LookVector * 0.25

if Model:IsA("Model") then
    Model:PivotTo(TargetCFrame)
elseif Model:IsA("BasePart") then
    Model.CFrame = TargetCFrame
end

local InteractPrompt = Model:FindFirstChild("InteractPrompt", true)

if InteractPrompt and InteractPrompt:IsA("ProximityPrompt") then

    InteractPrompt.Triggered:Connect(function(Player)

        if Player ~= LPlayer then
            return
        end

        InteractPrompt:Destroy()

        local Camera = workspace.CurrentCamera

        if not Camera then
            return
        end

        Camera.CameraType = Enum.CameraType.Scriptable

        local CameraPosition =
            Canvas.Position + Canvas.CFrame.LookVector * 6

        local TargetCameraCFrame =
            CFrame.lookAt(
                CameraPosition,
                Canvas.Position
            )

        local StartCFrame = Camera.CFrame

        local Duration = 1.5
        local StartTime = tick()

        local LerpConnection

        LerpConnection = RunService.RenderStepped:Connect(function()

            if not Camera.Parent or not Canvas.Parent then
                LerpConnection:Disconnect()
                return
            end

            local Alpha = math.clamp(
                (tick() - StartTime) / Duration,
                0,
                1
            )

            Alpha = 1 - (1 - Alpha) ^ 3

            Camera.CFrame =
                StartCFrame:Lerp(
                    TargetCameraCFrame,
                    Alpha
                )

            if Alpha >= 1 then
                LerpConnection:Disconnect()

                Camera.CFrame = TargetCameraCFrame

                pcall(function()
                    RunService:UnbindFromRenderStep("PaintingBlaCamera")
                end)

                RunService:BindToRenderStep(
                    "PaintingBlaCamera",
                    Enum.RenderPriority.Camera.Value + 1,
                    function()
                        if not Camera.Parent or not Canvas.Parent then
                            RunService:UnbindFromRenderStep("PaintingBlaCamera")
                            return
                        end

                        Camera.CameraType = Enum.CameraType.Scriptable

                        Camera.CFrame = CFrame.lookAt(
                            CameraPosition,
                            Canvas.Position
                        )
                    end
                )

                task.spawn(function()

                    task.wait(2)

                    if not ImageLabel or not ImageLabel.Parent then
                        return
                    end

                    local OriginalPosition = ImageLabel.Position

local Strength = Instance.new("NumberValue")
Strength.Value = 0

local ShakeRunning = true

task.spawn(function()
    while ShakeRunning and ImageLabel and ImageLabel.Parent do
        local Power = math.floor(Strength.Value)

        ImageLabel.Position =
            OriginalPosition
            + UDim2.fromOffset(
                math.random(-Power, Power),
                math.random(-Power, Power)
            )

        task.wait(0.01)
    end

    if ImageLabel and ImageLabel.Parent then
        ImageLabel.Position = OriginalPosition
    end
end)

