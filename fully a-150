Blur.Name = "PaintingBlaBlur"
Blur.Size = 0
Blur.Parent = game:GetService("Lighting")

local TweenInfo4 = TweenInfo.new(
    6,
    Enum.EasingStyle.Sine,
    Enum.EasingDirection.InOut
)

local StrengthTween = TweenService:Create(
    Strength,
    TweenInfo4,
    {
        Value = 5
    }
)

